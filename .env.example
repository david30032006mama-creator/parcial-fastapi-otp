# Copia este archivo como .env y completa los valores. NUNCA subas .env a GitHub.

APP_ENV=development            # development | production
# Genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=30
OTP_EXPIRE_MINUTES=15
DATABASE_URL=sqlite:///./app.db
RATE_LIMIT_ENABLED=true

# --- Correo por SMTP (smtplib) ---
# Ejemplo con Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación".
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASSWORD=contraseña-de-aplicacion
SMTP_FROM=tucorreo@gmail.com
SMTP_USE_TLS=true

# --- Alternativa por API HTTPS (si tu hosting bloquea SMTP, p. ej. Render gratis) ---
# EMAIL_BACKEND=brevo
# BREVO_API_KEY=
# SMTP_FROM=correo-verificado-en-brevo@ejemplo.com
